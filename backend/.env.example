# Chave da API Gemini (usada no RAG/LLM e análise multimodal do posto de trabalho)
GEMINI_API_KEY=

# Ambiente, CORS e HTTPS em produção (RNF03)
APP_ENV=development
ENFORCE_HTTPS=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Caminhos locais do RAG
CHROMA_PERSIST_DIR=./data/chroma
